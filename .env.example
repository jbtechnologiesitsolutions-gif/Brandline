# Server-only admin authentication settings. Never expose these with VITE_.
ADMIN_EMAIL=admin@brandlinetech.com
# Generate with: node scripts/generate-admin-hash.mjs "your-password"
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
